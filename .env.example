# ============================================================
#  PCI Chatbot — Variables de entorno (Backend API)
# ============================================================
#  Copiar este archivo como .env en apps/api/.env
#  y rellenar los valores reales. NUNCA commitear .env
# ============================================================

# --- Entorno ---
NODE_ENV=development

# --- Servidor API ---
PORT=3001

# --- Base de datos (PostgreSQL) ---
# Ejemplo local: postgresql://USER:PASS@localhost:5432/pci_chatbot
DATABASE_URL=postgresql://USUARIO:PASSWORD@localhost:5432/pci_chatbot

# --- Broker de mensajería (RabbitMQ) ---
# Ejemplo local: amqp://guest:guest@localhost:5672
RABBITMQ_URL=amqp://USUARIO:PASSWORD@localhost:5672

# --- Seguridad ---
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# 2FA por OTP. Todos estos parámetros se pueden cambiar en caliente desde /settings
# (el valor de BD le gana a estas env vars).
# Si OTP_ENABLED no se define, en NODE_ENV=development queda desactivado.
OTP_ENABLED=false
OTP_TTL_SECONDS=300
OTP_CODE_LENGTH=6

DEVICE_FINGERPRINT_TTL_DAYS=90

# Slug del tenant de sistema. Solo los usuarios con este tenant activo pueden
# gestionar /settings (configuración global). Lo crea el seed.
SYSTEM_TENANT_SLUG=system

# Clave maestra para cifrar las API keys que se cargan desde /settings (AES-256-GCM).
# Sin esto el backend RECHAZA guardar secrets, para no dejarlos en texto plano en la BD.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ Si la cambiás, los secrets ya guardados dejan de poder descifrarse y hay que recargarlos.
SETTINGS_ENCRYPTION_KEY=

# --- Capa de abstracción LLM ---
# Todo lo de abajo se puede cargar también desde /settings (la BD le gana al .env).
# Las API keys guardadas por /settings quedan cifradas con SETTINGS_ENCRYPTION_KEY.
# Proveedor por defecto: openai | gemini | claude | openrouter | opencodego | minimax
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenCode Go (opencode.ai). Host del `opencode serve`, con esquema y puerto.
# NO es compatible con OpenAI: trabaja con sesiones. La API key suele no hacer falta
# en un servidor local. El modelo va como providerID/modelID.
# OPENCODEGO_AGENT: `build` (default de opencode) ejecuta herramientas sobre la máquina
# del servidor. Para un bot de cara al usuario usamos `plan`, que no permite edición.
OPENCODEGO_API_URL=http://127.0.0.1:4096
OPENCODEGO_API_KEY=
OPENCODEGO_MODEL=opencode-go/kimi-k2.6
OPENCODEGO_AGENT=plan

# MiniMax. Compatible con el formato de OpenAI (/v1/chat/completions). La misma
# API key sirve para T2A (texto a voz) el día que se implemente esa parte —
# MiniMax usa un único Bearer token para ambas APIs.
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.5
MINIMAX_BASE_URL=https://api.minimax.io/v1

# Parámetros de generación LLM (configurables por tenant)
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
LLM_SYSTEM_PROMPT="Eres un asistente de soporte técnico útil y conciso."

# --- Invgate (usuario técnico con permisos API) ---
# Se gestiona desde /settings > "Integración: InvGate" (la BD le gana al .env, igual
# que LLM/WhatsApp/Twilio). Esto queda como fallback de bootstrap inicial.
INVGATE_API_URL=
INVGATE_API_USER=
INVGATE_API_KEY=
# Defaults de catálogo — usados solo cuando la charla no recolectó categoría/prioridad/
# tipo por nombre en flowState (ver ConversationsService.syncTicketToInvgate). category_id/
# priority_id/type_id son obligatorios en la API si no hay match por nombre, source_id es
# opcional. Correr `node apps/api/scripts/invgate-check.mjs` una vez que las credenciales
# de arriba funcionen para ver los IDs válidos — no hay un valor universal, son
# específicos de cada instalación.
INVGATE_DEFAULT_CATEGORY_ID=
INVGATE_DEFAULT_PRIORITY_ID=
INVGATE_DEFAULT_TYPE_ID=
INVGATE_DEFAULT_SOURCE_ID=

# --- WhatsApp: proveedor activo ---
# meta (Cloud API directa) | twilio. Decide cuál de los dos conectores de abajo se
# suscribe a la cola de envío saliente. Se lee una sola vez al arrancar el backend
# (a diferencia de LLM_PROVIDER): cambiarlo requiere reiniciar.
WHATSAPP_PROVIDER=meta

# --- WhatsApp Business API (Cloud API de Meta) ---
# Se gestiona desde /settings > "Mensajería: WhatsApp" (la BD le gana al .env, igual
# que el LLM). Webhook entrante: POST /webhooks/whatsapp — GET del mismo path lo usa
# Meta para verificar la suscripción, comparando hub.verify_token contra
# WHATSAPP_WEBHOOK_VERIFY_TOKEN.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- WhatsApp vía Twilio (alternativa a la Cloud API de Meta) ---
# Se gestiona desde /settings > "Mensajería: WhatsApp (Twilio)". Solo hace falta
# cargar esto si WHATSAPP_PROVIDER=twilio. Webhook entrante: POST /webhooks/twilio
# (sin handshake de verificación, a diferencia de Meta — se pega la URL directo en la
# consola de Twilio). Sin plantillas aprobadas todavía (deuda técnica compartida con
# el conector de Meta, ver docs/plan-de-trabajo.md).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número habilitado para WhatsApp en Twilio, E.164 con "+". El sandbox de pruebas es
# +14155238886. No incluir el prefijo "whatsapp:", se agrega solo.
TWILIO_WHATSAPP_FROM=

# --- SMS vía Twilio (canal propio, no alternativa de WhatsApp) ---
# Se gestiona desde /settings > "Mensajería: SMS (Twilio)". Reusa TWILIO_ACCOUNT_SID/
# TWILIO_AUTH_TOKEN de arriba (misma cuenta de Twilio). Webhook entrante: POST
# /webhooks/twilio-sms.
# Número de Twilio habilitado para SMS, E.164 con "+", SIN el prefijo "whatsapp:" (tiene
# que ser un número propio comprado en Twilio, el sandbox de WhatsApp no sirve acá).
TWILIO_SMS_FROM=

# --- Email saliente (SMTP) ---
# Se gestiona desde /settings > "Mensajería: Email". Sin EMAIL_SMTP_HOST configurado,
# los emails (ej. el código OTP) quedan solo logueados en consola — no rompe el dev.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=

# ============================================================
#  Frontend (apps/web/.env) — solo variables NEXT_PUBLIC_*
# ============================================================

# URL del backend NestJS
NEXT_PUBLIC_API_URL=http://localhost:3001

# Debe coincidir con SYSTEM_TENANT_SLUG del backend: decide si el sidebar
# muestra el ítem "Configuración" (/settings).
NEXT_PUBLIC_SYSTEM_TENANT_SLUG=system
