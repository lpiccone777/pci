generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  phone         String?  @unique
  // Interno telefónico de la persona. Va acá y no en `UserTenant` porque es un dato de la
  // persona, no de la empresa: la misma persona tiene el mismo interno valga en la empresa
  // que valga (mismo criterio que `phone`). Lo usará un voicebot a futuro; hoy solo se carga.
  // Opcional a propósito (se carga a mano y la mayoría no lo tiene) y único para que dos
  // personas no compartan interno —un voicebot que enruta por interno tiene que resolver a
  // una sola persona—. Como el resto de los únicos, se libera con sufijo en la baja lógica.
  internalPhone String?  @unique
  passwordHash  String
  firstName     String?
  lastName      String?
  // Identificador de la persona en Invgate. Va acá y no en `UserTenant` porque la
  // integración usa una única instancia de Invgate para todo el sistema: la persona
  // tiene el mismo id valga en la empresa que valga. Si algún día cada tenant tiene
  // su propio Invgate, este campo se muda a la membresía.
  // Opcional a propósito: hoy se carga a mano y la mayoría de los usuarios no lo tiene.
  // Único para que un error de tipeo no deje dos usuarios apuntando al mismo id de
  // Invgate; en Postgres varios NULL conviven sin problema, así que no molesta a los
  // que están sin cargar.
  invgateUserId String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  // Baja lógica sin reactivación: una persona dada de baja conserva su fila —y con ella el
  // historial que la referencia— pero deja de existir para el sistema. No hay "restaurar":
  // para volver se da de alta una persona nueva, que arranca sin historial.
  // A diferencia de `Tenant`, la baja SÍ libera los campos únicos (email, teléfono,
  // invgateUserId): al marcar `deletedAt` se les agrega un sufijo con la fecha y hora de la
  // baja, así el valor original queda disponible para el alta nueva. La alternativa era un
  // índice único parcial (`WHERE deletedAt IS NULL`), descartada porque Prisma no lo soporta
  // en el DSL y porque obligaba a filtrar a mano en cada búsqueda por esos campos: una que
  // quedara sin filtrar dejaba entrar a un usuario dado de baja.
  // Ver `UsersService.softDeleteUser`.
  deletedAt     DateTime?

  tenants           UserTenant[]
  devices           Device[]
  deviceValidations DeviceValidation[]
  conversations     Conversation[]
  tickets           Ticket[]         @relation("TicketReporter")
  assignedTickets   Ticket[]         @relation("TicketAssignee")
  metrics           Metric[]
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Baja lógica: una empresa dada de baja conserva su fila (y sus datos) pero deja de
  // listarse. No se libera el slug, que es @unique global: una empresa dada de baja lo
  // sigue ocupando, y sí se puede reactivar.
  // Ojo al comparar con `User.deletedAt`: la baja de usuario sigue el criterio opuesto en
  // los dos ejes —libera sus campos únicos y no admite reactivación— porque son dos casos
  // distintos: una empresa vuelve con sus datos, una persona vuelve como alguien nuevo.
  deletedAt DateTime?

  users         UserTenant[]
  roles         Role[]
  areas         Area[]
  conversations Conversation[]
  tickets       Ticket[]
  metrics       Metric[]
  settings      Setting[]
  tenantFlows   TenantFlow[]
}

/// Agrupación de usuarios dentro de una empresa (Soporte, Ventas, Administración...).
/// Es solo para agrupar — auditoría y métricas. El motor de flujos IVR decide por rol,
/// nunca por área.
model Area {
  id        String   @id @default(cuid())
  name      String
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userTenants UserTenant[]

  @@unique([name, tenantId])
  @@index([tenantId])
}

model Role {
  id        String   @id @default(cuid())
  name      String
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions     RolePermission[]
  userTenants     UserTenant[]
  tenantFlowRoles TenantFlowRole[]

  @@unique([name, tenantId])
}

model RolePermission {
  id        String   @id @default(cuid())
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resource  String
  action    String
  createdAt DateTime @default(now())

  @@unique([roleId, resource, action])
}

model UserTenant {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  // El área va acá y no en User: la clave primaria de esta tabla ya es
  // (userId, tenantId), así que "un usuario pertenece como máximo a un área por
  // empresa" queda garantizado por la estructura, sin validarlo a mano. La misma
  // persona puede estar en Soporte en una empresa y en Ventas en otra.
  // Opcional a propósito: un usuario puede no tener área asignada.
  // `Restrict` respalda en la base la regla que aplica AreasService.remove: un área
  // con gente asignada no se borra.
  areaId    String?
  area      Area?    @relation(fields: [areaId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@id([userId, tenantId])
  @@index([areaId])
}

model Device {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint String   @unique
  userAgent   String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// Dispositivo (número de WhatsApp) validado por el nodo `device_validation` del
// motor de flujos. Fingerprint = hash(teléfono + email), distinto del Device de
// arriba (que es para el login web y usa teléfono + User-Agent del browser).
model DeviceValidation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone       String
  email       String
  fingerprint String   @unique
  verifiedAt  DateTime @default(now())
  expiresAt   DateTime

  @@index([userId])
}

model Conversation {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  channel       String
  externalId    String?
  status        String   @default("active") // "active" | "closed"
  closedAt      DateTime? // Cuándo se cerró; habilita reanudarla dentro de la ventana de resume.
  currentFlowId String?
  currentNodeId String?
  flowState     Json? // Variables del flujo: { problemDescription: "...", ticketId: "944" }
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages Message[]
  metrics  Metric[]

  @@index([userId, tenantId])
  @@index([status])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     String
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Ticket {
  id           String   @id @default(cuid())
  invgateId    String?  @unique
  userId       String
  user         User     @relation("TicketReporter", fields: [userId], references: [id])
  // Colaborador asignado por el nodo `transfer_agent` (round robin sobre
  // `data.assignees`). Null si el ticket no vino de una transferencia, o si
  // el método "ticket" no estaba tildado.
  assignedToId String?
  assignedTo   User?    @relation("TicketAssignee", fields: [assignedToId], references: [id])
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  subject      String
  description  String?
  status       String   @default("open")
  priority     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, status])
  @@index([userId])
  @@index([assignedToId])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([tenantId])
}

model Metric {
  id             String        @id @default(cuid())
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  channel        String
  responseTimeMs Int
  resolution     String
  timestamp      DateTime      @default(now())
  createdAt      DateTime      @default(now())

  @@index([tenantId, timestamp])
  @@index([userId])
}

model Flow {
  id          String       @id @default(cuid())
  name        String
  description String?
  nodes       Json // ReactFlow nodes JSON
  edges       Json // ReactFlow edges JSON
  isActive    Boolean      @default(true)
  isDefault   Boolean      @default(false) // Flujo por defecto si no hay match
  // Fuente de datos que respalda las respuestas de este flujo. Lista cerrada
  // (ver FLOW_CONTEXT_OPTIONS en flow-context.ts): 'none' | 'invgate' | 'internal_kb' | 'other'.
  context     String       @default("none")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenantFlows TenantFlow[]
  createdBy   String? // userId
  roundRobins FlowNodeRoundRobin[]

  @@index([isActive])
  @@index([isDefault])
  @@index([context])
}

// Estado del round robin de un nodo `transfer_agent`: a quién le tocó la
// última vez, para repartir ordenadamente entre `data.assignees` sin
// importar cuántas conversaciones distintas pasen por el nodo.
model FlowNodeRoundRobin {
  id        String   @id @default(cuid())
  flowId    String
  flow      Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)
  nodeId    String
  lastIndex Int      @default(-1)
  updatedAt DateTime @updatedAt

  @@unique([flowId, nodeId])
}

model TenantFlow {
  id       String  @id @default(cuid())
  flowId   String
  tenantId String
  // Flujo de inicio PARA ESTE TENANT. Va acá y no en Flow: un mismo flujo puede
  // estar asignado a varios tenants y ser "de inicio" solo para algunos — por eso
  // no puede ser un booleano a nivel Flow. La invariante "un tenant tiene como
  // máximo un flujo de inicio" se aplica en FlowService.applyTenantAssignment,
  // no acá (Prisma no soporta índices únicos parciales en el schema DSL).
  isStart  Boolean @default(false)
  flow     Flow             @relation(fields: [flowId], references: [id], onDelete: Cascade)
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles    TenantFlowRole[]

  @@unique([flowId, tenantId])
  @@index([tenantId])
  @@index([flowId])
  @@index([isStart])
}

// Roles habilitados para un flujo dentro de una empresa. Cada fila = un rol que
// recibe ese flujo en ese tenant. Cuelga de TenantFlow (el par flujo↔empresa) y
// no de Flow: los roles son por tenant, y un mismo flujo puede tener distintos
// roles habilitados en cada empresa. Sin filas para un TenantFlow → ese flujo no
// lo recibe nadie en esa empresa. La invariante "un flujo de inicio por (empresa
// + rol)" se aplica en FlowService.applyTenantAssignment, no con constraint de BD.
model TenantFlowRole {
  id           String     @id @default(cuid())
  tenantFlowId String
  tenantFlow   TenantFlow @relation(fields: [tenantFlowId], references: [id], onDelete: Cascade)
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([tenantFlowId, roleId])
  @@index([roleId])
}
