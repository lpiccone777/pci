# ============================================================
#  PCI Chatbot — Variables de entorno (Backend API)
# ============================================================
#  Copiar este archivo como .env en apps/api/.env
#  y rellenar los valores reales. NUNCA commitear .env
# ============================================================

# --- Entorno ---
NODE_ENV=development

# --- Servidor API ---
PORT=3001

# --- Base de datos (PostgreSQL) ---
# Ejemplo local: postgresql://USER:PASS@localhost:5432/pci_chatbot
DATABASE_URL=postgresql://USUARIO:PASSWORD@localhost:5432/pci_chatbot

# --- Broker de mensajería (RabbitMQ) ---
# Ejemplo local: amqp://guest:guest@localhost:5672
RABBITMQ_URL=amqp://USUARIO:PASSWORD@localhost:5672

# --- Seguridad ---
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
OTP_TTL_SECONDS=300
DEVICE_FINGERPRINT_TTL_DAYS=30

# --- Capa de abstracción LLM ---
# Proveedor por defecto: openai | gemini | anthropic | openrouter | opencodego
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENCODEGO_API_URL=
OPENCODEGO_API_KEY=
OPENCODEGO_MODEL=opencode-go-1

# Parámetros de generación LLM (configurables por tenant)
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
LLM_SYSTEM_PROMPT="Eres un asistente de soporte técnico útil y conciso."

# --- Invgate (usuario técnico con permisos API) ---
INVGATE_API_URL=
INVGATE_API_USER=
INVGATE_API_KEY=

# --- WhatsApp Business API ---
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
