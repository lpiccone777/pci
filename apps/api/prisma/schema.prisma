generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  phone         String?  @unique
  passwordHash  String
  firstName     String?
  lastName      String?
  // Identificador de la persona en Invgate. Va acá y no en `UserTenant` porque la
  // integración usa una única instancia de Invgate para todo el sistema: la persona
  // tiene el mismo id valga en la empresa que valga. Si algún día cada tenant tiene
  // su propio Invgate, este campo se muda a la membresía.
  // Opcional a propósito: hoy se carga a mano y la mayoría de los usuarios no lo tiene.
  // Único para que un error de tipeo no deje dos usuarios apuntando al mismo id de
  // Invgate; en Postgres varios NULL conviven sin problema, así que no molesta a los
  // que están sin cargar.
  invgateUserId String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenants           UserTenant[]
  devices           Device[]
  deviceValidations DeviceValidation[]
  conversations     Conversation[]
  tickets           Ticket[]           @relation("TicketReporter")
  assignedTickets   Ticket[]           @relation("TicketAssignee")
  metrics           Metric[]
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Baja lógica: una empresa dada de baja conserva su fila (y sus datos) pero deja de
  // listarse. Es el primer softdelete del sistema — la baja de usuario, en cambio, borra
  // la membresía (UserTenant). No se libera el slug, que es @unique global: una empresa
  // dada de baja lo sigue ocupando. La restauración quedó fuera de alcance por ahora.
  deletedAt DateTime?

  users          UserTenant[]
  roles          Role[]
  areas          Area[]
  conversations  Conversation[]
  tickets        Ticket[]
  metrics        Metric[]
  settings       Setting[]
  tenantFlows    TenantFlow[]
  contextSources ContextSource[]
}

/// Agrupación de usuarios dentro de una empresa (Soporte, Ventas, Administración...).
/// Es solo para agrupar — auditoría y métricas. El motor de flujos IVR decide por rol,
/// nunca por área.
model Area {
  id        String   @id @default(cuid())
  name      String
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userTenants UserTenant[]

  @@unique([name, tenantId])
  @@index([tenantId])
}

model Role {
  id        String   @id @default(cuid())
  name      String
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions     RolePermission[]
  userTenants     UserTenant[]
  tenantFlowRoles TenantFlowRole[]

  @@unique([name, tenantId])
}

model RolePermission {
  id        String   @id @default(cuid())
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resource  String
  action    String
  createdAt DateTime @default(now())

  @@unique([roleId, resource, action])
}

model UserTenant {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  // El área va acá y no en User: la clave primaria de esta tabla ya es
  // (userId, tenantId), así que "un usuario pertenece como máximo a un área por
  // empresa" queda garantizado por la estructura, sin validarlo a mano. La misma
  // persona puede estar en Soporte en una empresa y en Ventas en otra.
  // Opcional a propósito: un usuario puede no tener área asignada.
  // `Restrict` respalda en la base la regla que aplica AreasService.remove: un área
  // con gente asignada no se borra.
  areaId    String?
  area      Area?    @relation(fields: [areaId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@id([userId, tenantId])
  @@index([areaId])
}

model Device {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint String   @unique
  userAgent   String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// Dispositivo (número de WhatsApp) validado por el nodo `device_validation` del
// motor de flujos. Fingerprint = hash(teléfono + email), distinto del Device de
// arriba (que es para el login web y usa teléfono + User-Agent del browser).
model DeviceValidation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone       String
  email       String
  fingerprint String   @unique
  verifiedAt  DateTime @default(now())
  expiresAt   DateTime

  @@index([userId])
}

model Conversation {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  channel       String
  externalId    String?
  status        String    @default("active") // "active" | "closed"
  closedAt      DateTime? // Cuándo se cerró; habilita reanudarla dentro de la ventana de resume.
  sessionStartedAt DateTime? // Se resetea al crear o reanudar la charla; acota qué Message cuentan como historial de la sesión actual (una reanudación reusa el mismo id, así que sin esto el historial de antes del cierre se filtraba al LLM).
  currentFlowId String?
  currentNodeId String?
  flowState     Json? // Variables del flujo: { problemDescription: "...", ticketId: "944" }
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  messages Message[]
  metrics  Metric[]

  @@index([userId, tenantId])
  @@index([status])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     String
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Ticket {
  id           String   @id @default(cuid())
  invgateId    String?  @unique
  userId       String
  user         User     @relation("TicketReporter", fields: [userId], references: [id])
  // Colaborador asignado por el nodo `transfer_agent` (round robin sobre
  // `data.assignees`). Null si el ticket no vino de una transferencia, o si
  // el método "ticket" no estaba tildado.
  assignedToId String?
  assignedTo   User?    @relation("TicketAssignee", fields: [assignedToId], references: [id])
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  subject      String
  description  String?
  status       String   @default("open")
  priority     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, status])
  @@index([userId])
  @@index([assignedToId])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([tenantId])
}

model Metric {
  id             String        @id @default(cuid())
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  channel        String
  responseTimeMs Int
  resolution     String
  timestamp      DateTime      @default(now())
  createdAt      DateTime      @default(now())

  @@index([tenantId, timestamp])
  @@index([userId])
}

model Flow {
  id              String               @id @default(cuid())
  name            String
  description     String?
  nodes           Json // ReactFlow nodes JSON
  edges           Json // ReactFlow edges JSON
  isActive        Boolean              @default(true)
  isDefault       Boolean              @default(false) // Flujo por defecto si no hay match
  // Fuente de datos que respalda las respuestas de este flujo. Lista cerrada
  // (ver FLOW_CONTEXT_OPTIONS en flow-context.ts): 'none' | 'invgate' | 'internal_kb' | 'other'.
  // DEPRECATED: reemplazado de a poco por contextSourceId (ver ContextSource). Se
  // conserva por compatibilidad con flujos existentes — no se borra en esta etapa.
  context         String               @default("none")
  // Fuente de verdad (MCP/RAG/n8n/broker) que este flujo puede consultar durante la
  // conversación. Nullable: no todos los flujos necesitan una. La ejecución real
  // (consultarla desde el motor de conversaciones) es trabajo de una etapa
  // posterior — ver docs/plan-de-trabajo.md, sección "Fuentes de verdad".
  contextSourceId String?
  contextSource   ContextSource?       @relation(fields: [contextSourceId], references: [id], onDelete: SetNull)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  tenantFlows     TenantFlow[]
  createdBy       String? // userId
  roundRobins     FlowNodeRoundRobin[]

  @@index([isActive])
  @@index([isDefault])
  @@index([context])
  @@index([contextSourceId])
}

/// Fuente de verdad externa que un flujo puede consultar para dar contexto a sus
/// respuestas: un servidor MCP remoto, un servicio de RAG, un webhook de n8n, o un
/// proceso propio suscripto a una cola de nuestro RabbitMQ (`broker`).
/// No instalamos ni hosteamos nada de esto — `config` guarda los parámetros de
/// conexión a un servicio que ya corre en otro lado.
///
/// Por tenant (como Area), no por flujo: la misma fuente se puede reusar entre
/// varios flujos de la empresa sin duplicar credenciales. `type` decide qué forma
/// tiene `config` — ver CONTEXT_SOURCE_TYPES en context-source-types.catalog.ts,
/// que es la única fuente de verdad (nunca mejor dicho) de qué tipos y campos son
/// válidos, igual que SETTINGS_CATALOG para `Setting`.
///
/// Los campos marcados `secret` en el catálogo viajan cifrados dentro de `config`
/// (mismo mecanismo que SecretsCipher usa para `Setting`: AES-256-GCM, nunca en
/// texto plano en la fila). Un GET nunca devuelve el valor real de esos campos.
model ContextSource {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  // 'mcp' | 'rag' | 'n8n' | 'broker' (catálogo abierto en código, ver context-source-types.catalog.ts).
  // String y no enum de Prisma para poder sumar tipos nuevos sin migración de schema.
  type      String
  config    Json     @default("{}")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  flows Flow[]

  @@unique([name, tenantId])
  @@index([tenantId])
  @@index([type])
}

// Estado del round robin de un nodo `transfer_agent`: a quién le tocó la
// última vez, para repartir ordenadamente entre `data.assignees` sin
// importar cuántas conversaciones distintas pasen por el nodo.
model FlowNodeRoundRobin {
  id        String   @id @default(cuid())
  flowId    String
  flow      Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)
  nodeId    String
  lastIndex Int      @default(-1)
  updatedAt DateTime @updatedAt

  @@unique([flowId, nodeId])
}

model TenantFlow {
  id       String  @id @default(cuid())
  flowId   String
  tenantId String
  // Flujo de inicio PARA ESTE TENANT. Va acá y no en Flow: un mismo flujo puede
  // estar asignado a varios tenants y ser "de inicio" solo para algunos — por eso
  // no puede ser un booleano a nivel Flow. La invariante "un tenant tiene como
  // máximo un flujo de inicio" se aplica en FlowService.applyTenantAssignment,
  // no acá (Prisma no soporta índices únicos parciales en el schema DSL).
  isStart  Boolean @default(false)
  flow     Flow             @relation(fields: [flowId], references: [id], onDelete: Cascade)
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles    TenantFlowRole[]

  @@unique([flowId, tenantId])
  @@index([tenantId])
  @@index([flowId])
  @@index([isStart])
}

// Roles habilitados para un flujo dentro de una empresa. Cada fila = un rol que
// recibe ese flujo en ese tenant. Cuelga de TenantFlow (el par flujo↔empresa) y
// no de Flow: los roles son por tenant, y un mismo flujo puede tener distintos
// roles habilitados en cada empresa. Sin filas para un TenantFlow → ese flujo no
// lo recibe nadie en esa empresa. La invariante "un flujo de inicio por (empresa
// + rol)" se aplica en FlowService.applyTenantAssignment, no con constraint de BD.
model TenantFlowRole {
  id           String     @id @default(cuid())
  tenantFlowId String
  tenantFlow   TenantFlow @relation(fields: [tenantFlowId], references: [id], onDelete: Cascade)
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([tenantFlowId, roleId])
  @@index([roleId])
}
